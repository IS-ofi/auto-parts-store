{
  "name": "auto-parts-store",
  "version": "1.0.0",
  "description": "**AutoParts Hub** — це сучасна вебплатформа для зручного пошуку, вибору та купівлі автомобільних запчастин. Застосунок створений для того, щоб об'єднати власників автомобілів і надійних постачальників автокомпонентів в одному інтуїтивно зрозумілому інтерфейсі, мінімізуючи час на пошук потрібної деталі.",
  "main": "server/server.js",
  "scripts": {
    "start": "node server/server.js",
    "start:static": "node server/server.js --static",
    "dev": "node --watch server/server.js",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{js,json,html,css,md}\"",
    "build": "node scripts/build-check.js",
    "test": "node scripts/test-all.js",
    "test:fast": "node --test \"test/unit/*.test.js\" test/api.memory.test.js test/architecture.test.js test/smoke.test.js test/static.test.js",
    "test:coverage": "node --test --experimental-test-coverage \"test/unit/*.test.js\" test/api.memory.test.js test/architecture.test.js test/smoke.test.js test/static.test.js",
    "test:unit": "node --test \"test/unit/*.test.js\"",
    "test:integration": "node --test \"test/integration/*.test.js\"",
    "test:e2e": "node --test \"test/e2e/*.test.js\"",
    "mutation": "stryker run",
    "prepare": "husky",
    "format:check": "prettier --check \"**/*.{js,mjs,json,html,css,md}\""
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/IS-ofi/auto-parts-store.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/IS-ofi/auto-parts-store/issues"
  },
  "homepage": "https://github.com/IS-ofi/auto-parts-store#readme",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stryker-mutator/core": "^9.0.0",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "mongodb-memory-server": "^11.3.0",
    "prettier": "^3.9.9"
  },
  "lint-staged": {
    "*.{js,mjs}": [
      "eslint --max-warnings 0",
      "prettier --check"
    ],
    "*.{json,css,html,md}": [
      "prettier --check"
    ]
  },
  "dependencies": {
    "mongodb": "^7.7.0"
  },
  "engines": {
    "node": ">=22.22.1"
  }
}
